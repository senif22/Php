BUGS.md

# CodeIgniter Files
# NOTE: app/Config/* and app/Views/errors/ are part of the application
# skeleton and MUST be committed, otherwise spark cannot bootstrap on a
# fresh clone. Only environment files and writable/ contents are ignored.
.env

# writable/ contents are ignored, but the directory structure is kept
# (directories must be re-included before .gitkeep inside them can be)
writable/**
!writable/**/
!writable/**/.gitkeep

# Composer
vendor/

